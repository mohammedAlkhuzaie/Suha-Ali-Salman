package org.example.behavioral.notification;
 
import org.springframework.stereotype.Service;
 
import java.util.ArrayList;
import java.util.List;
 
/**
 * Subject. Registered as a Spring bean so its list of observers can be
 * populated automatically from every Observer bean in the context (see
 * the constructor) -- adding a new notification channel is then just
 * "write a class implementing Observer and annotate it @Component", with
 * no change needed here or in OrderService.
 */
@Service
public class NotificationService {
    private final List<Observer> observers = new ArrayList<>();
 
    public NotificationService(List<Observer> registeredObservers) {
        this.observers.addAll(registeredObservers);
    }
 
    public void addObserver(Observer observer) {
        observers.add(observer);
    }
 
    public void notifyObservers(String message) {
        for (Observer observer : observers) {
            observer.update(message);
        }
    }
}
