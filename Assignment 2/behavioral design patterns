class OrderValidationChainTest {
 
    private OrderValidationHandler buildChain() {
        OrderValidationHandler inventory = new InventoryCheckHandler();
        OrderValidationHandler payment = new PaymentValidationHandler();
        inventory.setNext(payment);
        return inventory;
    }
 
    private Order validOrder() {
        Order order = new Order();
        order.setCustomerName("Alice");
        order.setTotalAmount(150.0);
        order.setPaymentMethod("CREDIT_CARD");
        order.setStatus(Order.STATUS_PENDING);
        return order;
    }
 
    @Test
    void validOrderPassesTheWholeChain() {
        assertDoesNotThrow(() -> buildChain().validate(validOrder()));
    }
 
    @Test
    void orderExceedingInventoryCapacityIsRejectedByInventoryHandler() {
        Order order = validOrder();
        order.setTotalAmount(50_000.0);
 
        assertThrows(OrderValidationException.class, () -> buildChain().validate(order));
    }
 
    @Test
    void orderWithZeroAmountIsRejectedByPaymentHandler() {
        Order order = validOrder();
        order.setTotalAmount(0.0);
 
        assertThrows(OrderValidationException.class, () -> buildChain().validate(order));
    }
 
    @Test
    void orderWithUnsupportedPaymentMethodIsRejectedByPaymentHandler() {
