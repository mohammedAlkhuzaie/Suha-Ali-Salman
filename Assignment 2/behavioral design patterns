package org.example.behavioral.handler;
 
import lombok.extern.slf4j.Slf4j;
import org.example.behavioral.entity.Order;
import org.example.behavioral.exception.OrderValidationException;
 
/**
 * Concrete handler: checks that the order is fulfillable from stock.
 *
 * This module has no dedicated inventory table (out of scope for this
 * assignment), so stock is simulated with a simple per-order cap that
 * stands in for "insufficient inventory for this quantity/value". Swap
 * this method's body for a real repository lookup (e.g. an
 * InventoryRepository keyed by SKU) without touching any other handler
 * or the chain itself -- that's the point of the pattern.
 */
@Slf4j
public class InventoryCheckHandler extends OrderValidationHandler {
 
    private static final double MAX_SINGLE_ORDER_VALUE = 10_000.0;
 
    @Override
    public void validate(Order order) {
        if (order.getTotalAmount() > MAX_SINGLE_ORDER_VALUE) {
            log.warn("Inventory check failed for order from {}: amount {} exceeds available stock capacity {}",
                    order.getCustomerName(), order.getTotalAmount(), MAX_SINGLE_ORDER_VALUE);
            throw new OrderValidationException(
                    "Insufficient inventory to fulfill an order of this size.");
        }
        log.info("Inventory check passed for order from {}.", order.getCustomerName());
        super.validate(order);
    }
}
