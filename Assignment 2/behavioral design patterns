package org.example.behavioral.handler;
 
import lombok.extern.slf4j.Slf4j;
import org.example.behavioral.entity.Order;
import org.example.behavioral.exception.OrderValidationException;
import org.example.behavioral.payment.PaymentStrategyFactory;
 
/**
 * Concrete handler: validates the payment details before the order is
 * allowed to proceed to placement. Delegates the "is this a supported
 * payment method" question to PaymentStrategyFactory so the set of valid
 * methods is defined in exactly one place (the Strategy registry).
 */
@Slf4j
public class PaymentValidationHandler extends OrderValidationHandler {
 
    @Override
    public void validate(Order order) {
        if (order.getTotalAmount() <= 0) {
            log.warn("Payment validation failed for order from {}: non-positive amount {}",
                    order.getCustomerName(), order.getTotalAmount());
            throw new OrderValidationException("Order total must be greater than zero.");
        }
        if (!PaymentStrategyFactory.isSupported(order.getPaymentMethod())) {
            log.warn("Payment validation failed for order from {}: unsupported payment method '{}'",
                    order.getCustomerName(), order.getPaymentMethod());
            throw new OrderValidationException(
                    "Unsupported payment method: " + order.getPaymentMethod());
        }
        log.info("Payment validation passed for order from {}.", order.getCustomerName());
        super.validate(order);
    }
}
