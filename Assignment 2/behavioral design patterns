package org.example.behavioral.notification;
 
import org.junit.jupiter.api.Test;
 
import java.util.ArrayList;
import java.util.List;
 
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;
 
class NotificationServiceTest {
 
    /** Test double recording every message it receives. */
    private static class RecordingObserver implements Observer {
        final List<String> received = new ArrayList<>();
 
        @Override
        public void update(String message) {
            received.add(message);
        }
    }
 
    @Test
    void notifiesAllObserversRegisteredAtConstruction() {
        RecordingObserver email = new RecordingObserver();
        RecordingObserver sms = new RecordingObserver();
        NotificationService service = new NotificationService(List.of(email, sms));
 
        service.notifyObservers("Order 1 has been placed.");
 
        assertEquals(List.of("Order 1 has been placed."), email.received);
        assertEquals(List.of("Order 1 has been placed."), sms.received);
    }
 
    @Test
    void newlyAddedObserverReceivesSubsequentNotifications() {
        NotificationService service = new NotificationService(List.of());
        RecordingObserver observer = new RecordingObserver();
 
        service.addObserver(observer);
        service.notifyObservers("Order 2 status changed.");
 
        assertTrue(observer.received.contains("Order 2 status changed."));
    }
 
    @Test
    void noObserversMeansNoErrors() {
        NotificationService service = new NotificationService(List.of());
        service.notifyObservers("No one is listening.");
        // No exception = pass.
    }
}
