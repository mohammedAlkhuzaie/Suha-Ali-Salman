package org.example.behavioral.service;
 
import lombok.extern.slf4j.Slf4j;
import org.example.behavioral.command.OrderCommand;
import org.example.behavioral.command.PlaceOrderCommand;
import org.example.behavioral.entity.Order;
import org.example.behavioral.exception.OrderValidationException;
import org.example.behavioral.handler.InventoryCheckHandler;
import org.example.behavioral.handler.OrderValidationHandler;
import org.example.behavioral.handler.PaymentValidationHandler;
import org.example.behavioral.notification.NotificationService;
import org.example.behavioral.payment.PaymentStrategy;
import org.example.behavioral.payment.PaymentStrategyFactory;
import org.example.behavioral.repository.OrderRepository;
import org.springframework.stereotype.Service;
 
import java.util.List;
import java.util.NoSuchElementException;
 
/**
 * Business logic layer. This class is the one place where all four
 * behavioral patterns meet:
 *
 *  - Chain of Responsibility: the order runs through a validation chain
 *    (Inventory -> Payment) before it's allowed to proceed.
 *  - Strategy: the customer's chosen payment method is charged via
 *    whichever PaymentStrategy PaymentStrategyFactory returns.
 *  - Command: placing the order itself is encapsulated as a
 *    PlaceOrderCommand, executed rather than inlined here.
 *  - Observer: once the order is placed or its status changes, every
 *    registered notification channel is informed via NotificationService.
 */
@Slf4j
@Service
public class OrderService {
 
    private final OrderRepository orderRepository;
    private final NotificationService notificationService;
 
    public OrderService(OrderRepository orderRepository, NotificationService notificationService) {
        this.orderRepository = orderRepository;
        this.notificationService = notificationService;
    }
 
    public Order placeOrder(Order order) {
        log.info("Placing order for customer {} (amount={}, method={})",
                order.getCustomerName(), order.getTotalAmount(), order.getPaymentMethod());
 
        // 1. Chain of Responsibility: validate before doing anything else.
        OrderValidationHandler chain = buildValidationChain();
        try {
            chain.validate(order);
        } catch (OrderValidationException ex) {
            log.warn("Order rejected for customer {}: {}", order.getCustomerName(), ex.getMessage());
            order.setStatus(Order.STATUS_REJECTED);
            throw ex;
        }
 
        // 2. Strategy: charge the customer using the requested payment method.
        PaymentStrategy paymentStrategy = PaymentStrategyFactory.get(order.getPaymentMethod());
        paymentStrategy.pay(order.getTotalAmount());
 
        // Persist once up front so the command/notification steps have an id to reference.
        Order saved = orderRepository.save(order);
 
        // 3. Command: encapsulate the "place this order" action.
        OrderCommand placeOrderCommand = new PlaceOrderCommand(saved);
        placeOrderCommand.execute();
        saved = orderRepository.save(saved);
 
        // 4. Observer: notify every registered channel that the order was placed.
        notificationService.notifyObservers(
                "Order " + saved.getId() + " for " + saved.getCustomerName() + " has been placed.");
 
        return saved;
    }
 
    public Order updateStatus(Long orderId, String newStatus) {
        Order order = orderRepository.findById(orderId)
                .orElseThrow(() -> new NoSuchElementException("Order not found: " + orderId));
        order.updateStatus(newStatus);
        Order saved = orderRepository.save(order);
 
        notificationService.notifyObservers(
                "Order " + saved.getId() + " status changed to " + newStatus + ".");
 
        return saved;
    }
 
    public List<Order> getAllOrders() {
        return orderRepository.findAll();
    }
 
    public Order getOrderById(Long orderId) {
        return orderRepository.findById(orderId)
                .orElseThrow(() -> new NoSuchElementException("Order not found: " + orderId));
    }
 
    public void deleteOrder(Long orderId) {
        if (!orderRepository.existsById(orderId)) {
            throw new NoSuchElementException("Order not found: " + orderId);
        }
        orderRepository.deleteById(orderId);
    }
 
    /**
     * Assembles the Chain of Responsibility. This is the only place the
     * chain's order (inventory before payment) is decided -- neither
     * handler knows about the other.
     */
    private OrderValidationHandler buildValidationChain() {
        OrderValidationHandler inventoryCheck = new InventoryCheckHandler();
        OrderValidationHandler paymentValidation = new PaymentValidationHandler();
        inventoryCheck.setNext(paymentValidation);
        return inventoryCheck;
    }
}
