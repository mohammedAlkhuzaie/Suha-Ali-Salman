package org.example.behavioral.service;
 
import org.example.behavioral.entity.Order;
import org.example.behavioral.exception.OrderValidationException;
import org.example.behavioral.notification.NotificationService;
import org.example.behavioral.repository.OrderRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
 
import java.util.NoSuchElementException;
import java.util.Optional;
 
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;
 
@ExtendWith(MockitoExtension.class)
class OrderServiceTest {
 
    @Mock
    private OrderRepository orderRepository;
 
    @Mock
    private NotificationService notificationService;
 
    private OrderService orderService;
 
    @BeforeEach
    void setUp() {
        orderService = new OrderService(orderRepository, notificationService);
    }
 
    private Order validOrder() {
        Order order = new Order();
        order.setCustomerName("Carol");
        order.setTotalAmount(200.0);
        order.setPaymentMethod("CREDIT_CARD");
        order.setStatus(Order.STATUS_PENDING);
        return order;
    }
 
    @Test
    void placeOrderSavesTwiceAndNotifiesObservers() {
        Order order = validOrder();
        when(orderRepository.save(any(Order.class))).thenAnswer(inv -> {
            Order arg = inv.getArgument(0);
            arg.setId(42L);
            return arg;
        });
 
        Order result = orderService.placeOrder(order);
 
        assertEquals(42L, result.getId());
        assertEquals(Order.STATUS_PLACED, result.getStatus());
        verify(orderRepository, times(2)).save(any(Order.class));
        verify(notificationService).notifyObservers(contains("Order 42"));
    }
 
    @Test
    void placeOrderRejectsInvalidPaymentMethodBeforeSaving() {
        Order order = validOrder();
        order.setPaymentMethod("BITCOIN");
 
        assertThrows(OrderValidationException.class, () -> orderService.placeOrder(order));
 
        verify(orderRepository, never()).save(any(Order.class));
        verify(notificationService, never()).notifyObservers(any());
        assertEquals(Order.STATUS_REJECTED, order.getStatus());
    }
 
    @Test
    void updateStatusNotifiesObserversWithNewStatus() {
        Order existing = validOrder();
        existing.setId(7L);
        existing.setStatus(Order.STATUS_PLACED);
 
        when(orderRepository.findById(7L)).thenReturn(Optional.of(existing));
        when(orderRepository.save(any(Order.class))).thenAnswer(inv -> inv.getArgument(0));
 
        Order updated = orderService.updateStatus(7L, Order.STATUS_SHIPPED);
 
        assertEquals(Order.STATUS_SHIPPED, updated.getStatus());
        verify(notificationService).notifyObservers(contains("SHIPPED"));
    }
 
    @Test
    void updateStatusThrowsWhenOrderMissing() {
        when(orderRepository.findById(99L)).thenReturn(Optional.empty());
 
        assertThrows(NoSuchElementException.class, () -> orderService.updateStatus(99L, "SHIPPED"));
    }
 
    @Test
    void getOrderByIdThrowsWhenMissing() {
        when(orderRepository.findById(1L)).thenReturn(Optional.empty());
 
        assertThrows(NoSuchElementException.class, () -> orderService.getOrderById(1L));
    }
 
    @Test
    void deleteOrderThrowsWhenMissing() {
        when(orderRepository.existsById(5L)).thenReturn(false);
 
        assertThrows(NoSuchElementException.class, () -> orderService.deleteOrder(5L));
        verify(orderRepository, never()).deleteById(any());
    }
 
    @Test
    void deleteOrderDelegatesToRepositoryWhenPresent() {
        when(orderRepository.existsById(5L)).thenReturn(true);
 
        orderService.deleteOrder(5L);
 
        verify(orderRepository).deleteById(5L);
    }
}
