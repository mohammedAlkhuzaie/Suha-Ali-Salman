package org.example.behavioral.payment;
 
import java.util.Locale;
import java.util.Set;
 
/**
 * Selects the concrete PaymentStrategy for a given payment method string.
 * This is where "which methods exist" is defined in one place, so both
 * OrderService (to actually charge the customer) and
 * PaymentValidationHandler (to check the method is supported) can rely on
 * it instead of duplicating a list of valid methods.
 */
public class PaymentStrategyFactory {
 
    private static final Set<String> SUPPORTED_METHODS = Set.of("CREDIT_CARD", "PAYPAL");
 
    private PaymentStrategyFactory() {
    }
 
    public static boolean isSupported(String paymentMethod) {
        return paymentMethod != null && SUPPORTED_METHODS.contains(paymentMethod.toUpperCase(Locale.ROOT));
    }
 
    public static PaymentStrategy get(String paymentMethod) {
        if (paymentMethod == null) {
            throw new IllegalArgumentException("paymentMethod must not be null");
        }
        return switch (paymentMethod.toUpperCase(Locale.ROOT)) {
            case "CREDIT_CARD" -> new CreditCardPayment();
            case "PAYPAL" -> new PayPalPayment();
            default -> throw new IllegalArgumentException("Unsupported payment method: " + paymentMethod);
        };
    }
}
