package org.example.behavioral.payment;
 
/**
 * Strategy Pattern
 * ----------------
 * Encapsulates each payment method as an interchangeable algorithm behind
 * one interface. OrderService depends only on PaymentStrategy -- it never
 * references CreditCardPayment or PayPalPayment directly -- so a new
 * payment method can be added by writing one new class and registering it
 * in PaymentStrategyFactory, with no change to OrderService.
 */
public interface PaymentStrategy {
    void pay(double amount);
}
